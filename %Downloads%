#!/usr/bin/env python3
import os
import sys

# Allowed file extensions (case-insensitive)
ALLOWED_EXTENSIONS = {'.fx', '.py', '.md'}

def replace_in_file(filepath):
    """Replace '^^' with '^|' in the given file."""
    try:
        # Read the file content
        with open(filepath, 'r', encoding='utf-8') as file:
            content = file.read()
        
        # Check if '^^' exists in the file
        if '^^' not in content:
            return False
        
        # Replace all occurrences of '^^' with '^|'
        new_content = content.replace('^^', '^|')
        
        # Write back to the file
        with open(filepath, 'w', encoding='utf-8') as file:
            file.write(new_content)
        
        return True
    
    except Exception as e:
        print(f"Error processing {filepath}: {e}")
        return False

def process_directory(directory, script_name):
    """Recursively process all files in a directory and its subdirectories."""
    processed_count = 0
    modified_count = 0
    skipped_count = 0
    
    try:
        # Walk through all directories and files
        for root, dirs, files in os.walk(directory):
            for filename in files:
                filepath = os.path.join(root, filename)
                
                # Skip the script itself
                if filepath == os.path.join(directory, script_name):
                    continue
                
                # Check if file has an allowed extension (case-insensitive)
                ext = os.path.splitext(filename)[1].lower()
                if ext not in ALLOWED_EXTENSIONS:
                    skipped_count += 1
                    continue
                
                # Process the file
                if replace_in_file(filepath):
                    modified_count += 1
                processed_count += 1
    
    except Exception as e:
        print(f"Error walking directory: {e}")
    
    return processed_count, modified_count, skipped_count

def main():
    # Get the directory where this script is located
    script_dir = os.path.dirname(os.path.abspath(__file__))
    script_name = os.path.basename(__file__)
    
    print(f"Starting recursive scan in: {script_dir}")
    print(f"Looking for files with extensions: {', '.join(ALLOWED_EXTENSIONS)}")
    print("-" * 50)
    
    # Process all files recursively
    processed_count, modified_count, skipped_count = process_directory(script_dir, script_name)
    
    print("-" * 50)
    print(f"Processed {processed_count} files, modified {modified_count} files, skipped {skipped_count} files (wrong extension).")

if __name__ == "__main__":
    main()